{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name','role']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('role').isString()"
          }
        },
        "votes": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            }
          }
        }
      }
    }
  }
}